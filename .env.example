# opto-rio-rest-collector configuration
# populate specific variables to match environment configuration

# --- groov RIO / Manage REST API (required) ---
OPTO_HOST=replace-me
OPTO_API_KEY=replace-me
OPTO_DEVICE=local
OPTO_MODULE=0
OPTO_ANALOG_CHANNELS=8
OPTO_POLL_INTERVAL_MS=500

# for demo purposes: skips TLS cert verification for the device's self-signed cert.
# Set to false (and provide a trusted cert) for anything beyond a local demo.
OPTO_TLS_INSECURE=true
OPTO_INCLUDE_RAW=false

# --- output ---
# stdout | mqtt | both
OUTPUT_MODE=mqtt

# --- MQTT (used for OUTPUT_MODE=mqtt or both) ---
MQTT_URL=tcp://mosquitto:1883
MQTT_TOPIC=opto/rio/grv-r7-mm1001-10/state
MQTT_CLIENT_ID=opto-rio-rest-collector
MQTT_QOS=0
MQTT_RETAIN=false
MQTT_USERNAME=
MQTT_PASSWORD=
